# Project 7: Hospital Patient Data Analysis System - Environment Configuration
# Copy this file to .env and adjust values for your local demonstration machine.
# Never commit real database passwords to version control.

# Set DB_ENGINE=mysql for MySQL server, or DB_ENGINE=sqlite for instant local demo
DB_ENGINE=mysql

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hospital_analytics_user
MYSQL_PASSWORD=replace_with_local_mysql_password
MYSQL_DATABASE=hospital_analytics_db

# Role-based access token required in X-Analyst-Token header for individual record endpoints
ANALYST_API_TOKEN=edu-hospital-ops-token-2026
